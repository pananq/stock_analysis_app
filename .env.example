# 复制为 .env，文件只保存在当前项目目录且不会被 Git 跟踪。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=stock_analysis
MYSQL_USER=stock_user
MYSQL_PASSWORD=change-me

TUSHARE_TOKEN=
DATASOURCE_TYPE=akshare
WEB_SECRET_KEY=replace-with-a-different-long-random-secret
AUTH_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_INITIAL_PASSWORD=

AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=reports@example.com
SMTP_USE_SSL=false
SMTP_STARTTLS=true
REPORT_RECIPIENTS=recipient@example.com

DAILY_REPORT_ENABLED=false
DAILY_REPORT_TIME=20:00
DAILY_REPORT_USER_ID=1
